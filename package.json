{
  "name": "allin-local",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node build/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "test:browser": "playwright test",
    "package:linux": "npm run build && node scripts/package-linux.mjs",
    "export:public": "node scripts/export-public.mjs",
    "screenshots": "npm run build && tsx scripts/screenshots.ts",
    "test:build": "npm run build && node --import tsx --test tests/build/*.test.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
