# AllIn settings for the Docker install. Copy this to docker.env and edit it. See INSTALL_DOCKER.md.
# Lines starting with # are unset. The image sets the data folder, the key folder and the port.

# The box's WireGuard address, the exact address you type in the browser, and the certificate
# files. If WireGuard runs in a container, the address is that container's tunnel address.
# Set ALLIN_LISTEN and ALLIN_ORIGIN, and leave the two certificate lines as they are.
# The port in ALLIN_ORIGIN must be 4310 unless you also add ALLIN_PORT here.
#ALLIN_LISTEN=10.8.0.1
#ALLIN_ORIGIN=https://10.8.0.1:4310
ALLIN_TLS_CERT=/etc/allin/tls/server.crt
ALLIN_TLS_KEY=/etc/allin/tls/server.key
