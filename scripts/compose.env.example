# Only for a box where WireGuard runs in a container. Copy this to .env, in the same folder as
# compose.yaml, and put the name of your WireGuard container on the second line. Compose reads
# .env by itself. These are settings for compose, not for AllIn: AllIn's own are in docker.env.
COMPOSE_FILE=compose.yaml:compose.wireguard.yaml
ALLIN_WIREGUARD_CONTAINER=
