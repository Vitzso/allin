# AllIn settings. The installer copies this to /etc/allin/allin.env only if that file is missing.
# Lines starting with # are unset. See INSTALL_LINUX.md.

ALLIN_PORT=4310
ALLIN_DATA_DIR=/var/lib/allin/vault
ALLIN_KEYSTORE_DIR=/var/lib/allin/keys

# Network mode: the box's WireGuard address, the exact address you type in the browser,
# and the certificate files. Set all four together, or none of them (loopback only).
#ALLIN_LISTEN=10.8.0.1
#ALLIN_ORIGIN=https://10.8.0.1:4310
#ALLIN_TLS_CERT=/etc/allin/tls/server.crt
#ALLIN_TLS_KEY=/etc/allin/tls/server.key
